#!/usr/bin/env bash
# homelab-mcp —— 本地 harness 的 stdio MCP 启动器（SSH 到 ali 的 mcp 用户）
# 环境变量:
#   HOMELAB_AGENT    身份标签(codex/opencode/pi/cli), 用于审计与吊销
#   HOMELAB_AGENT_KEY 私钥路径(默认 ~/.ssh/homelab_agent)
set -euo pipefail

AGENT="${HOMELAB_AGENT:-cli}"
KEY="${HOMELAB_AGENT_KEY:-$HOME/.ssh/homelab_agent}"

exec ssh -i "$KEY" \
  -o IdentitiesOnly=yes \
  -o BatchMode=yes \
  -o StrictHostKeyChecking=accept-new \
  -o ConnectTimeout=10 \
  -o ServerAliveInterval=30 \
  -o ServerAliveCountMax=3 \
  mcp@flagw.apay.eu.cc "exec /usr/local/bin/homelab-mcpd --agent ${AGENT}"
