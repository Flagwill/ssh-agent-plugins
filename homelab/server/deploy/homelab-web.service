[Unit]
Description=homelab web console + collector (PWA + REST)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcp
Group=mcp
WorkingDirectory=/opt/homelab
Environment=HOMELAB_CONFIG=/opt/homelab/hosts.toml
ExecStart=/usr/bin/python3 -m homelab.webapp
Restart=always
RestartSec=3
NoNewPrivileges=true
# 不设 PrivateTmp/ProtectHome: agent 的只读命令(run_read)要能看真实 /tmp 与 /home;
# SSH ControlMaster 目录随之移到 /opt/homelab/run/ssh(ProtectSystem=strict 下 /tmp 只读)
ProtectSystem=strict
ReadWritePaths=/var/lib/homelab /var/log/homelab /opt/homelab
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
